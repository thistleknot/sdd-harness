{
  "model": "haiku",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "context7@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "caveman@caveman": true,
    "aiup-core@ai-unified-process-marketplace": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/membank.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/log_event.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.harness/hooks/session_resume.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/playbook.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/process_ledger.py --watermark",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& 'C:/Users/user/.caveman/bin/caveman-proxy.exe' native-hook claude --adapter 'C:/Users/user/AppData/Roaming/npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/membank.py",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/log_event.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/spec_state.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/skills/retrieve-skills/hook.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.harness/hooks/codebase_map.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/playbook.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/playbook.py --plan",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& 'C:/Users/user/.caveman/bin/caveman-proxy.exe' native-hook claude --adapter 'C:/Users/user/AppData/Roaming/npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "shell": "powershell",
            "timeout": 60
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.harness/hooks/plan_do_route.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/log_event.py"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|NotebookEdit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/file_manifest.py",
            "timeout": 10,
            "statusMessage": "Checking file table..."
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/spec_gate.py",
            "timeout": 15,
            "statusMessage": "Checking spec gate..."
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.harness/hooks/security_scan.py",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/source_write_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& 'C:/Users/user/.caveman/bin/caveman-proxy.exe' native-hook claude --adapter 'C:/Users/user/AppData/Roaming/npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& 'C:/Users/user/AppData/Roaming/npm/caveman.CMD' shrink-hook",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "F:/Python/uv-tools/bin/graphify.EXE hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "F:/Python/uv-tools/bin/graphify.EXE hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/log_event.py"
          }
        ]
      },
      {
        "matcher": "^(Read|Edit|Write|NotebookEdit|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/spec_state.py"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/py310/Scripts/python.exe C:/Users/user/.harness/hooks/turn_write_log.py",
            "timeout": 3
          },
          {
            "type": "command",
            "command": "C:/Users/user/py310/Scripts/python.exe C:/Users/user/.harness/hooks/test_gen.py",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/spec_attribution.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^ExitPlanMode$",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/playbook.py --pivot",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit)$",
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/source_write_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& 'C:/Users/user/.caveman/bin/caveman-proxy.exe' native-hook claude --adapter 'C:/Users/user/AppData/Roaming/npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/log_event.py"
          },
          {
            "type": "command",
            "command": "C:/Users/user/py310/Scripts/python.exe C:/Users/user/.harness/hooks/session_end.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& 'C:/Users/user/.caveman/bin/caveman-proxy.exe' native-hook claude --adapter 'C:/Users/user/AppData/Roaming/npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/verify_gate.py"
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/log_event.py"
          },
          {
            "type": "command",
            "command": "C:/Users/user/py310/Scripts/python.exe C:/Users/user/.harness/hooks/self_review.py"
          },
          {
            "type": "command",
            "command": "C:/Users/user/py310/Scripts/python.exe C:/Users/user/.harness/hooks/review_changes.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "C:/Users/user/py310/Scripts/python.exe C:/Users/user/.harness/hooks/session_handoff.py --mode handoff"
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/task_lineage.py",
            "timeout": 15,
            "statusMessage": "Checking file-to-task lineage..."
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/file_manifest.py --audit",
            "timeout": 15,
            "statusMessage": "Auditing unclaimed files..."
          },
          {
            "type": "command",
            "command": "python C:/Users/user/.claude/hooks/process_ledger.py",
            "timeout": 10,
            "statusMessage": "Checking process ledger..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& 'C:/Users/user/.caveman/bin/caveman-proxy.exe' native-hook claude --adapter 'C:/Users/user/AppData/Roaming/npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/user/py310/Scripts/python.exe C:/Users/user/.harness/hooks/pre_compact.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "& 'C:/Users/user/.caveman/bin/caveman-proxy.exe' native-hook claude --adapter 'C:/Users/user/AppData/Roaming/npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
            "shell": "powershell",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": {
      "hooks": [
        {
          "type": "command",
          "command": "& 'C:/Users/user/.caveman/bin/caveman-proxy.exe' native-hook claude --adapter 'C:/Users/user/AppData/Roaming/npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
          "shell": "powershell",
          "timeout": 30
        }
      ]
    },
    "SubagentStart": {
      "hooks": [
        {
          "type": "command",
          "command": "& 'C:/Users/user/.caveman/bin/caveman-proxy.exe' native-hook claude --adapter 'C:/Users/user/AppData/Roaming/npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
          "shell": "powershell",
          "timeout": 30
        }
      ]
    },
    "SubagentStop": {
      "hooks": [
        {
          "type": "command",
          "command": "& 'C:/Users/user/.caveman/bin/caveman-proxy.exe' native-hook claude --adapter 'C:/Users/user/AppData/Roaming/npm/node_modules/@caveman-ai/cli/dist/native-hook-fast.js'",
          "shell": "powershell",
          "timeout": 30
        }
      ]
    }
  },
  "effortLevel": "medium",
  "plansDirectory": ".tmp/plans",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "env": {
    "MCP_TIMEOUT": "120000",
    "MCP_TOOL_TIMEOUT": "900000",
    "ENABLE_TOOL_SEARCH": "auto"
  },
  "autoUpdatesChannel": "latest",
  "agentPushNotifEnabled": true,
  "mcpServers": {},
  "autoMode": {
    "environment": [
