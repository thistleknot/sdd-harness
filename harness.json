{
  "_comment": "Shared harness config. Run `python adapter.py` to sync to all harnesses.",
  "mcp_servers": {
    "retrieve-skills": {
      "type": "http",
      "url": "http://127.0.0.1:8765/mcp"
    },
    "memory-index": {
      "type": "http",
      "url": "http://127.0.0.1:8055/mcp"
    },
    "todo": {
      "type": "http",
      "url": "http://127.0.0.1:8056/mcp"
    },
    "data-science-skills": {
      "type": "stdio",
      "command": "F:/Python/mcp/data-science-skills/Scripts/python.exe",
      "args": [
        "C:/Users/user/.skills/parallel-rrf-graph-rag-hybrid-cascade-mmr-late-retriever/scripts/mcp_server.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "specs": {
      "type": "http",
      "url": "http://127.0.0.1:8057/mcp"
    },
    "graphify": {
      "type": "stdio",
      "command": "F:/Python/uv-tools/bin/graphify-mcp.exe",
      "args": [],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "agentic-kanban": {
      "type": "stdio",
      "command": "F:/Python/mcp/agentic-kanban/Scripts/python.exe",
      "args": [
        "C:/Users/user/.harness/board_mcp.py"
      ],
      "env": {
        "PYTHONIOENCODING": "utf-8",
        "PYTHONUTF8": "1"
      }
    },
    "rea": {
      "type": "stdio",
      "command": "C:/tools/rea-deps/node/node-v24.18.0-win-x64/node.exe",
      "args": [
        "C:/Users/user/AppData/Local/npm-cache/_npx/dea9475797100b20/node_modules/rea-agents/scripts/rea.mjs",
        "mcp"
      ]
    }
  },
  "opencode_plugins": [
    "@tarquinen/opencode-dcp@latest"
  ],
  "opencode_caveman": {
    "enabled": true
  },
  "opencode_agent_tools": {
    "orchestrator": {
      "rea*": false
    }
  },
  "opencode_agent_permissions": {
    "oracle": {
      "bash": "deny",
      "edit": "deny",
      "write": "deny",
      "task": "deny",
      "retrieve-skills_retrieve_skills": "allow",
      "retrieve-skills_read_skill": "allow"
    }
  },
  "opencode_context_proxy": {
    "enabled": true,
    "provider": "litellm",
    "upstream_url": "http://127.0.0.1:4000/v1",
    "proxy_url": "http://127.0.0.1:8789/v1",
    "health_url": "http://127.0.0.1:8789/health",
    "command": "C:/Users/user/py310/Scripts/headroom.exe",
    "port": 8789,
    "mode": "token"
  },
  "codex_context_proxy": {
    "enabled": true,
    "provider": "copilot-proxy",
    "upstream_url": "http://127.0.0.1:4000/v1",
    "proxy_url": "http://127.0.0.1:8789/v1",
    "health_url": "http://127.0.0.1:8789/health",
    "command": "C:/Users/user/py310/Scripts/headroom.exe",
    "port": 8789,
    "mode": "token"
  },
  "global_hooks": {
    "claude": [
      {
        "event": "UserPromptSubmit",
        "command": "python C:/Users/user/.harness/hooks/plan_do_route.py",
        "timeout": 10
      },
      {
        "event": "PreToolUse",
        "matcher": "Bash|Grep",
        "command": "F:/Python/uv-tools/bin/graphify.EXE hook-guard search",
        "timeout": 10
      },
      {
        "event": "PreToolUse",
        "matcher": "Read|Glob",
        "command": "F:/Python/uv-tools/bin/graphify.EXE hook-guard read",
        "timeout": 10
      }
    ],
    "codex": [
      {
        "event": "PreToolUse",
        "matcher": "Bash",
        "command": "F:/Python/uv-tools/bin/graphify.EXE hook-check"
      }
    ]
  },
  "model_routing": {
    "claude-code": {
      "orchestrator": "claude-sonnet-5",
      "planner": "claude-opus-5",
      "critic": "claude-sonnet-5",
      "fixer": "claude-opus-4-8",
      "architect": "claude-fable-5",
      "worker": "claude-haiku-4.5"
    },
    "local": {
      "orchestrator": "qwen35-oc-4b-128k:latest",
      "planner": "qwen38-9b-oracle:128k",
      "critic": "qwen35-oc-2b-128k:latest",
      "fixer": "qwen35-oc-4b-128k:latest",
      "architect": "hf.co/huihui-ai/Huihui-gemma-4-12B-agentic-fable5-abliterated-GGUF:Huihui-gemma4-v2-abliterated-Q8_0.gguf",
      "worker": "qwen35-oc-4b-128k:latest"
    }
  },
  "skill_packages": {
    "_comment": "Canonical skill packages projected by adapter.py --target skills when --skill is omitted. Source: ai-unified-process/aiup-core@3.13.0 (Tessl), copied into the skill master (~/.skills).",
    "packages": [
      "acceptance-protocol",
      "architecture-decision",
      "business-process",
      "entity-model",
      "recursive-harness-self-improvement",
      "next",
      "open-questions",
      "release-notes",
      "requirements",
      "reverse-engineer",
      "spec-review",
      "stack",
      "test-case",
      "test-case-coverage",
      "test-case-implement",
      "use-case-coverage",
      "use-case-diagram",
      "use-case-implement",
      "use-case-spec",
      "use-case-test",
      "user-guide"
    ]
  },
  "memory": {
    "default_scope": "project_shared",
    "dense_enabled": false,
    "derive_enabled": false,
    "consolidate_enabled": false,
    "govern_enabled": false,
    "default_k": 5,
    "max_k": 20,
    "max_content_chars": 6000,
    "master": "C:\\Users\\user\\.skills",
    "policy": "docs/playbooks/memory-and-harness-integration.md"
  }
}
